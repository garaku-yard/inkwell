# ──────────────────────────────────────────────────────────────────────────────
# Inkwell environment configuration
#
# Copy this file to `.env` and fill in the values you need. Services read these
# variables at startup; all have sensible dev defaults, so only JWT_SECRET and
# any production-facing secrets are strictly required.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Database credentials (shared by every per-service Postgres container) ────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── Per-service Postgres hosts/ports (override for non-docker dev) ──────────
# Defaults match docker-compose.yml. Override to point at a remote DB.
# IDENTITY_DB_HOST=localhost
# IDENTITY_DB_PORT=5432
# SCRIPTS_DB_HOST=localhost
# SCRIPTS_DB_PORT=5433
# COLLAB_DB_HOST=localhost
# COLLAB_DB_PORT=5434
# BILLING_DB_HOST=localhost
# BILLING_DB_PORT=5435
# WORKSPACE_DB_HOST=localhost
# WORKSPACE_DB_PORT=5436
# AISETTINGS_DB_HOST=localhost
# AISETTINGS_DB_PORT=5437
# NOTIFICATIONS_DB_HOST=localhost
# NOTIFICATIONS_DB_PORT=5438

# ─── Redis (JWT blocklist + rate limiter) ─────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Kafka (async domain events) ──────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_PORT=9092
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# ─── JWT (REQUIRED — identity service refuses to start without it) ────────────
# Generate with: openssl rand -base64 48
# In any environment other than ENVIRONMENT=development, identity rejects an
# empty value and exits immediately rather than signing tokens with a default.
JWT_SECRET=change-me-to-a-long-random-value
# JWT_ACCESS_EXPIRY=24h
# JWT_REFRESH_EXPIRY=168h

# ─── AI-settings encryption key (REQUIRED for the hosted BYO path) ────────────
# 32 random bytes, base64-encoded. Used by the ai-settings service to
# AES-256-GCM encrypt user-supplied API keys at rest in Postgres.
#
# WARNING: rotating this key without a re-encryption migration makes every
# stored API key undecryptable and every existing chat request fails.
# Treat this as a one-time commitment — generate it, back it up offline,
# and only rotate alongside a batch re-encrypt job that reads with the old
# key and writes with the new. (The DB has a `key_version` column reserved
# for this; no rotation code ships today.)
# Generate with: openssl rand -base64 32
AI_ENCRYPTION_KEY=change-me-to-a-base64-encoded-32-byte-key

# ─── API gateway ──────────────────────────────────────────────────────────────
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Requests per minute per IP. Set 0 to disable rate limiting.
RATE_LIMIT_RPM=120
# Stricter per-IP bucket applied to /login, /register and /users/me/password.
AUTH_RATE_LIMIT_RPM=10
# Per-user bucket on AI endpoints (chat + BYO settings CRUD). Bills and
# enumeration attacks scale with the user account, not the source IP.
AI_RATE_LIMIT_RPM=30

# Allowlist of host[:port] entries that `openai_compatible` provider rows
# may dispatch to. Empty (the default) keeps the kind off on the hosted
# path — users can still create rows but the gateway refuses to call
# them, since arbitrary URLs would let a malicious user point Inkwell's
# server at internal services (SSRF). Set this when self-hosting and
# you want the server to talk to your own LLM endpoint, e.g.:
#   AI_OPENAI_COMPATIBLE_HOSTS=ollama.internal:11434,llm.corp.local:8080
# Match is exact against the URL's Host field. List the host with the
# same port your users will configure (or no port, for implicit 80/443).
# Local Ollama still works in the desktop app regardless of this setting
# — the desktop adapter dispatches from the user's own machine, so SSRF
# doesn't apply there.
AI_OPENAI_COMPATIBLE_HOSTS=

# ─── Managed AI (Inkwell-supplied keys) ──────────────────────────────────────
# Optional. Set a provider's key to OFFER managed AI for that provider — users
# can chat without bringing their own key. Managed usage is metered per user and
# capped by their tier's monthly allowance (max_ai_requests_per_month); BYO keys
# stay un-metered. Leave empty (default) and only BYO providers work.
# Model defaults are used when a request names none.
AI_MANAGED_OPENAI_KEY=
AI_MANAGED_OPENAI_MODEL=gpt-4o-mini
AI_MANAGED_ANTHROPIC_KEY=
AI_MANAGED_ANTHROPIC_MODEL=claude-haiku-4-5
AI_MANAGED_GEMINI_KEY=
AI_MANAGED_GEMINI_MODEL=gemini-2.0-flash

# ─── Service discovery (gRPC endpoints the gateway talks to) ─────────────────
# Override hosts when running services on different machines.
IDENTITY_SERVICE_HOST=localhost
IDENTITY_SERVICE_PORT=50051
SCRIPTS_SERVICE_HOST=localhost
SCRIPTS_SERVICE_PORT=50052
COLLAB_SERVICE_HOST=localhost
COLLAB_SERVICE_PORT=50053
BILLING_SERVICE_HOST=localhost
BILLING_SERVICE_PORT=50054
WORKSPACE_SERVICE_HOST=localhost
WORKSPACE_SERVICE_PORT=50056
AI_SETTINGS_SERVICE_HOST=localhost
AI_SETTINGS_SERVICE_PORT=50057
NOTIFICATIONS_SERVICE_HOST=localhost
NOTIFICATIONS_SERVICE_PORT=50058

# ─── Email delivery (notifications service) ──────────────────────────────────
# Inkwell runs no mail server — it's an SMTP *client*. Point these at a relay
# you control (self-hosted Postfix, Gmail SMTP, SendGrid/Mailgun SMTP, …) to
# turn on email notifications (welcome, "added to a project"). Leave SMTP_HOST
# empty (the default) and emails are logged instead of sent — nothing breaks.
# Auth is used only when SMTP_USERNAME is set, so anonymous port-25 relays work.
# STARTTLS is used opportunistically; set SMTP_IMPLICIT_TLS=true for port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@inkwell.app
SMTP_FROM_NAME=Inkwell
# SMTP_IMPLICIT_TLS=false
# SMTP_INSECURE_SKIP_VERIFY=false
# Public origin used for absolute links inside emails.
APP_BASE_URL=http://localhost:3000

# ─── Paddle (billing — hosted checkout, Merchant of Record) ──────────────────
# Billing is inert until PADDLE_API_KEY is set: the billing service offers no
# checkout and ignores webhooks, so the app runs fine unconfigured (Free tier
# only). Set these to turn paid plans on. Use the sandbox environment in dev.
#   PADDLE_API_KEY        — Paddle API key (Authorization: Bearer). Empty ⇒ off.
#   PADDLE_WEBHOOK_SECRET — notification destination secret (pdl_ntfset_…),
#                           used to verify the Paddle-Signature on webhooks.
#   PADDLE_ENVIRONMENT    — "sandbox" (default) or "production".
#   PADDLE_PRICE_MAP      — JSON mapping tier + billing cycle to Paddle price ID,
#                           e.g. {"pro:monthly":"pri_abc","pro:yearly":"pri_def"}.
# See server/docs/paddle-go-live.md for the complete four-price setup.
# Point Paddle's subscription.* webhooks at:
#   <gateway>/api/v1/billing/webhooks/paddle
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox
PADDLE_PRICE_MAP=

# ─── Frontend ────────────────────────────────────────────────────────────────
# Publicly exposed to the browser — do NOT put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Paddle.js client token used only by the public /checkout page. This is safe to
# expose to the browser. Use test_... in sandbox and live_... in production.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# Public OAuth client ID embedded in desktop builds for Google Drive backup.
GOOGLE_DRIVE_CLIENT_ID=708325195614-vu52s7bbu14i1cdjsd14hkirvaqk52mf.apps.googleusercontent.com
