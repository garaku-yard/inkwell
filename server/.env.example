# Database Configurations
# Identity Service Database
IDENTITY_DB_HOST=localhost
IDENTITY_DB_PORT=5432
IDENTITY_DB_USER=postgres
IDENTITY_DB_PASSWORD=your_password_here
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_SSLMODE=disable
IDENTITY_DB_MAX_OPEN_CONNS=25
IDENTITY_DB_MAX_IDLE_CONNS=10
IDENTITY_DB_CONN_MAX_LIFETIME=1h

# Scripts Service Database
SCRIPTS_DB_HOST=localhost
SCRIPTS_DB_PORT=5432
SCRIPTS_DB_USER=postgres
SCRIPTS_DB_PASSWORD=your_password_here
SCRIPTS_DB_NAME=scripts_db
SCRIPTS_DB_SSLMODE=disable
SCRIPTS_DB_MAX_OPEN_CONNS=25
SCRIPTS_DB_MAX_IDLE_CONNS=10
SCRIPTS_DB_CONN_MAX_LIFETIME=1h

# Collaboration Service Database
COLLAB_DB_HOST=localhost
COLLAB_DB_PORT=5432
COLLAB_DB_USER=postgres
COLLAB_DB_PASSWORD=your_password_here
COLLAB_DB_NAME=collaboration_db
COLLAB_DB_SSLMODE=disable
COLLAB_DB_MAX_OPEN_CONNS=25
COLLAB_DB_MAX_IDLE_CONNS=10
COLLAB_DB_CONN_MAX_LIFETIME=1h

# Service Ports
IDENTITY_GRPC_PORT=50051
SCRIPTS_GRPC_PORT=50052
COLLAB_GRPC_PORT=50053
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h
JWT_ISSUER=scriptlith-identity
JWT_SECRET=your_gateway_jwt_secret_here

# Service Discovery
IDENTITY_SERVICE_HOST=localhost
IDENTITY_SERVICE_PORT=50051
SCRIPTS_SERVICE_HOST=localhost
SCRIPTS_SERVICE_PORT=50052
COLLAB_SERVICE_HOST=localhost
COLLAB_SERVICE_PORT=50053
BILLING_SERVICE_HOST=localhost
BILLING_SERVICE_PORT=50054
AI_SERVICE_HOST=localhost
AI_SERVICE_PORT=50055
AI_CHAT_SERVICE_HOST=localhost
AI_CHAT_SERVICE_PORT=50054

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_USER_TOPIC=user-events
KAFKA_TOPIC_PREFIX=scriptlith
KAFKA_CONSUMER_GROUP=scripts-service

# Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@scriptlith.com

# Security Configuration
BCRYPT_COST=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=15m
PASSWORD_RESET_EXPIRY=1h
EMAIL_VERIFICATION_EXPIRY=24h

# Storage Configuration
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_BUCKET_NAME=scriptlith-files

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Environment
ENVIRONMENT=development