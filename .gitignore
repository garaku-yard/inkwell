# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/client/coverage       # Ignore coverage in the client directory

# next.js
.next
out/           # Ignore output files in the client directory

# production
/client/build          # Ignore build files in the client directory

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

CLAUDE.md

# python
venv/
.venv/
__pycache__/
*.pyc
*.pyo
